{
  "name": "@kie/act-js",
  "version": "0.0.0-semantically-released",
  "description": "nodejs wrapper for nektos/act",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "bin": {
    "act-js": "bin/act"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "build/src",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiegroup/act-js.git"
  },
  "homepage": "https://github.com/kiegroup/act-js#readme",
  "bugs": {
    "url": "https://github.com/kiegroup/act-js/issues"
  },
  "keywords": [
    "github",
    "github actions",
    "act",
    "nektos/act"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js 0.2.81",
    "build": "tsc && tsc-alias",
    "pretest:it": "npm run postinstall && mkdir -p bin && cp build/bin/* bin/",
    "test": "npm run test:unit && npm run test:it",
    "test:unit": "jest unit/",
    "test:it": "jest test/it/*",
    "test:report": "npm run test:unit -- --coverage --testResultsProcessor=jest-sonar-reporter",
    "pretest:ci": "npm run pretest:it",
    "test:ci": "jest ./test/ci/",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "file": "ts-node",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "author": "Shubh Bapna <sbapna@redhat.com>",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@actions/github": "^8.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@octokit/rest": "^21.0.0",
    "@types/express": "^5.0.0",
    "@types/follow-redirects": "^1.14.4",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axios": "^1.7.7",
    "eslint": "^10.0.1",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^15.0.0",
    "nock": "^13.5.5",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@kie/mock-github": "^2.0.2",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "bin-links": "^4.0.4",
    "express": "^4.21.1",
    "follow-redirects": "^1.15.9",
    "tar": "^7.4.3",
    "yaml": "^2.6.0"
  },
  "jestSonar": {
    "reportPath": "coverage"
  },
  "lint-staged": {
    "*.ts": "eslint --fix --max-warnings=0"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "labels": false,
          "releasedLabels": false
        }
      ]
    ]
  }
}
